NODE_ENV=development
PORT=3000
PLATFORM_NAME=Agentic

# Exact comma-separated origins. Leave empty to disable cross-origin access.
CORS_ORIGINS=http://localhost:3000

# Production must name the one proxy header that carries the client address.
# Use only a header your proxy sets and overwrites. If using x-forwarded-for,
# also set the proxy addresses/CIDRs so the client-supplied part is discarded.
# Example for AWS behind private load balancers:
# AUTH_IP_HEADERS=x-forwarded-for
# AUTH_TRUSTED_PROXIES=10.0.0.0/8,2001:db8::/32
# Example for Vercel:
# AUTH_IP_HEADERS=x-vercel-forwarded-for
# AUTH_TRUSTED_PROXIES=

# Postgres. Matches compose.yaml (`docker compose up -d --wait`). Required in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agentic?schema=public

# Better Auth. Required in production.
# Secret: at least 32 characters. Generate one with `openssl rand -base64 32`.
# Without it, development uses a random secret and sessions end on restart.
BETTER_AUTH_SECRET=
# This API's own origin, without a path.
BETTER_AUTH_URL=http://localhost:3000
# The frontend's origin (sign-in, consent and invitation pages). Required in production.
# Defaults to the first CORS origin. When the frontend and API share a parent domain
# (app.example.com, api.example.com), they share the login cookie automatically.
APP_URL=
# Better Auth Infrastructure: dashboard (dash) and email delivery for sign-in codes.
# Required in production. Without it, development logs the codes instead of emailing them.
BETTER_AUTH_API_KEY=
# OAuth sign-in. Set both ID and secret to switch a provider on. Redirect URI to
# register with each provider: <BETTER_AUTH_URL>/api/auth/callback/<google|github|linkedin>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Google reCAPTCHA (server secret). When set, sending and using sign-in codes needs a
# captcha token in the x-captcha-response header.
RECAPTCHA_SECRET_KEY=

# Swagger defaults to enabled outside production and disabled in production.
SWAGGER_ENABLED=true

# Observability is opt-in. Supply all credentials when enabling it.
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=

NODE_ENV=development
PORT=3000
PLATFORM_NAME=Agentic

# Exact comma-separated origins. Leave empty to disable cross-origin access.
CORS_ORIGINS=http://localhost:3000

# Postgres. Matches compose.yaml (`docker compose up -d --wait`). Required in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agentic?schema=public

# Better Auth. Required in production.
# Secret: at least 32 characters. Generate one with `openssl rand -base64 32`.
# Without it, development uses a random secret and sessions end on restart.
BETTER_AUTH_SECRET=
# This API's own origin, without a path.
BETTER_AUTH_URL=http://localhost:3000
# Optional. Set the parent domain (example.com) when the frontend and API run on
# subdomains of it (app.example.com, api.example.com), so they share the session cookie.
AUTH_COOKIE_DOMAIN=
# The frontend's origin (sign-in, consent and invitation pages). Required in production.
# Defaults to the first CORS origin.
APP_URL=
# Better Auth Infrastructure: dashboard (dash) and email delivery for sign-in codes.
# Required in production. Without it, development logs the codes instead of emailing them.
BETTER_AUTH_API_KEY=
# Google sign-in. Set both or neither. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google reCAPTCHA (server secret). When set, sending and using sign-in codes needs a
# captcha token in the x-captcha-response header.
RECAPTCHA_SECRET_KEY=
# Passkeys. Defaults to the APP_URL hostname.
PASSKEY_RP_ID=
# The MCP server URL that access tokens are issued for. Defaults to <BETTER_AUTH_URL>/mcp.
MCP_RESOURCE_URL=
# Client IP for rate limiting, comma-separated. Use only headers your proxy sets,
# for example cf-connecting-ip behind Cloudflare.
AUTH_IP_HEADERS=
AUTH_TRUSTED_PROXIES=

# Swagger defaults to enabled outside production and disabled in production.
SWAGGER_ENABLED=true

# Observability is opt-in. Supply all credentials when enabling it.
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=

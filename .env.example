NODE_ENV=development
PORT=3000
PLATFORM_NAME=Agentic

# Exact comma-separated origins. Leave empty to disable cross-origin access.
CORS_ORIGINS=http://localhost:3000

# Production must name the one proxy header that carries the client address.
# Use only a header your proxy sets and overwrites. If using x-forwarded-for,
# also set the proxy addresses/CIDRs so the client-supplied part is discarded.
# Example for AWS behind private load balancers:
# AUTH_IP_HEADERS=x-forwarded-for
# AUTH_TRUSTED_PROXIES=10.0.0.0/8,2001:db8::/32
# Example for Vercel:
# AUTH_IP_HEADERS=x-vercel-forwarded-for
# AUTH_TRUSTED_PROXIES=

# Postgres. Matches compose.yaml (`docker compose up -d --wait`). Required in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:6433/agentic?schema=public
# Straight to Postgres, for migrations only. Leave empty when DATABASE_URL is already direct.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agentic?schema=public
# Redis (or Valkey) for background jobs and routines. Required in production; locally the compose container.
REDIS_URL=redis://localhost:6380
# File storage for chat attachments: Cloudflare R2 (or any S3-compatible store). Required in production.
# R2: https://ACCESS_KEY_ID:SECRET_ACCESS_KEY@ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET?region=auto
# Locally: the MinIO container. If the secret has / or +, URL-encode it.
STORAGE_URL=http://minioadmin:minioadmin@localhost:9000/agentic?region=us-east-1

# Better Auth. Required in production.
# Secret: at least 32 characters. Generate one with `openssl rand -base64 32`.
# Without it, development uses an ephemeral secret; sessions and pending emails
# won't survive a restart. Set a local secret to keep them across restarts.
BETTER_AUTH_SECRET=
# This API's own origin, without a path.
BETTER_AUTH_URL=http://localhost:3000
# The frontend's origin (sign-in, consent and invitation pages). Required in production.
# Defaults to the first CORS origin. When the frontend and API share a parent domain
# (app.example.com, api.example.com), they share the login cookie automatically.
APP_URL=
# Optional. Better Auth Infrastructure: the dashboard and Sentinel (bot and abuse
# protection on sign-in). Off when empty. Not used for email.
BETTER_AUTH_API_KEY=

# Email (@nestjs/mail). SendByte (https://sendbyte.africa) is used when SENDBYTE_API_KEY is set, otherwise SMTP.
# Production needs MAIL_FROM and either SENDBYTE_API_KEY or SMTP_HOST.
SENDBYTE_API_KEY=
MAIL_FROM=
# Optional: where replies to our emails go (for example support@example.com). Without it they go to MAIL_FROM.
MAIL_REPLY_TO=
# SMTP. Locally these default to Mailpit from compose.yaml (inbox: http://localhost:8025).
# SMTP_PORT defaults to 587 for a real host; SMTP_SECURE defaults to true only on port 465.
# Set SMTP_USER and SMTP_PASSWORD together, or leave both empty.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# OAuth sign-in. Set both ID and secret to switch a provider on. Redirect URI to
# register with each provider: <BETTER_AUTH_URL>/v1/auth/callback/<google|github|discord>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google reCAPTCHA (server secret). When set, sending and using sign-in codes needs a
# captcha token in the x-captcha-response header.
RECAPTCHA_SECRET_KEY=

# Swagger defaults to enabled outside production and disabled in production.
SWAGGER_ENABLED=true

# Observability is opt-in. Supply all credentials when enabling it.
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=

# Optional. A Slack or Discord webhook that gets a message when the server or a background job fails.
ALERT_WEBHOOK_URL=

# Cencori: AI models, agents and memory. Optional; without it Cencori calls answer 503.
CENCORI_API_KEY=
# Optional. The signing secret of a Cencori webhook (event action.*) pointing at /v1/approvals/cencori, so app steps follow your tool rules.
CENCORI_WEBHOOK_SECRET=

# Optional: live voice calls with bots (LiveKit Cloud). Copy all three from your LiveKit project settings.
# Without them, voice calls answer 503.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. InstaBox (https://instabox.sh): gives each user's agents their own cloud computer. Leave empty to turn it off.
INSTABOX_API_KEY=

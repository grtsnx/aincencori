{
  "name": "agentic",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "better-call": "1.4.5"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build && tsc-alias -p tsconfig.build.json && node scripts/check-build.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,json,md}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,json,md}\" \".github/**/*.{yml,yaml}\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "start:worker": "node --watch-path=dist --env-file=.env --enable-source-maps dist/worker.js",
    "start:worker:prod": "node --enable-source-maps dist/worker.js",
    "start:voice": "node --env-file=.env --enable-source-maps dist/voice-worker.js dev",
    "start:voice:prod": "node --enable-source-maps dist/voice-worker.js start",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:debug": "NODE_ENV=test vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "NODE_ENV=test vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "eval": "bun scripts/evals.ts",
    "load-test": "bun scripts/load-test.ts",
    "auth:encrypt-oauth-tokens": "bun scripts/encrypt-oauth-tokens.ts",
    "auth:generate": "auth generate --config src/config/auth/better-auth.cli.ts --adapter prisma --dialect postgresql --output prisma/schema.prisma --yes && node scripts/fix-auth-schema.mjs && prisma format"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@better-auth/agent-auth": "0.6.2",
    "@better-auth/cimd": "1.7.22",
    "@better-auth/infra": "0.4.30",
    "@better-auth/mcp": "1.7.22",
    "@better-auth/passkey": "1.7.22",
    "@livekit/agents": "1.9.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mail": "0.0.2",
    "@nestjs/observe": "^0.3.17",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@scalar/nestjs-api-reference": "^1.2.31",
    "better-auth": "1.7.22",
    "better-auth-harmony": "1.3.2",
    "bullmq": "6.5.1",
    "cencori": "1.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron-parser": "5.10.2",
    "express": "^5.3.0",
    "ioredis": "6.0.0",
    "livekit-server-sdk": "2.19.2",
    "mammoth": "1.13.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "auth": "1.7.22",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.9.9",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}

// The app's database. Run `bun run db:migrate` after you change it.
// The Better Auth models below come from `bun run auth:generate`; regenerate them
// instead of editing by hand when you change Better Auth options or plugins.
// Extra @@index lines added by hand are kept by the generator: they cover lookups
// Better Auth makes often (Google sign-in, membership checks, foreign keys).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  twoFactorEnabled   Boolean?            @default(false)
  role               String?
  banned             Boolean?            @default(false)
  banReason          String?
  banExpires         DateTime?
  lastLoginMethod    String?
  passkeys           Passkey[]
  twofactors         TwoFactor[]
  teammembers        TeamMember[]
  members            Member[]
  invitations        Invitation[]
  oauthclients       OauthClient[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]

  agenthosts         AgentHost[]
  routines           Routine[]
  agents             Agent[]
  agentGrantsGranted AgentCapabilityGrant[] @relation("AgentGrantGrantedBy")
  agentGrantsDenied  AgentCapabilityGrant[] @relation("AgentGrantDeniedBy")
  approvalrequests   ApprovalRequest[]

  normalizedEmail String?

  @@unique([email])
  @@unique([normalizedEmail])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy       String?
  activeOrganizationId String?
  activeTeamId         String?
  oauthrefreshtokens   OauthRefreshToken[]
  oauthaccesstokens    OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  teams       Team[]
  members     Member[]
  invitations Invitation[]

  organizationroles OrganizationRole[]

  @@unique([slug])
  @@map("organization")
}

model Team {
  id             String       @id
  name           String
  memberCount    Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id            String    @id
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipKey String?
  createdAt     DateTime?

  @@unique([membershipKey])
  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  teamId         String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@map("invitation")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauthResource")
}

model OauthClientResource {
  id            String        @id
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@index([expiresAt])
  @@map("oauthClientAssertion")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model EmailOutbox {
  id                String    @id
  payload           String
  status            String    @default("pending")
  attempts          Int       @default(0)
  availableAt       DateTime  @default(now())
  lockedAt          DateTime?
  sentAt            DateTime?
  lastErrorCategory String?
  createdAt         DateTime  @default(now())

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@map("emailOutbox")
}

// One chat with an agent. The id is Cencori's session id; we keep who owns it
// so people can only continue their own chats.
model ChatSession {
  id        String        @id
  userId    String
  title     String
  // Set when a routine started this chat (one chat per run).
  routineId String?
  // The bot this chat is with. Empty: the default assistant.
  botId     String?
  // The group of bots this chat is with, if any.
  groupId   String?
  // When its bot last learned from it (see BotSuggestion).
  learnedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@index([routineId, createdAt])
  @@map("chatSession")
}

// Every message of a chat, kept by us. Cencori only answers; the history is
// ours, so we can switch AI providers without losing it.
model ChatMessage {
  id          String            @id
  sessionId   String
  session     ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // "user", "agent" or "human" (a person on our team).
  role        String
  // Which agent answered, for example "Agentic".
  agent       String?
  text        String
  // Widgets the agent showed (cards, lists, charts).
  widgets     Json?
  // Names of attached files. The files themselves are not kept.
  attachments Json?
  // Next steps the agent offered, shown as buttons: ["Draft the email"].
  followUps   Json?
  // The earlier message this one replies to (quoted, like in WhatsApp).
  replyToId   String?
  replyTo     ChatMessage?      @relation("Reply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[]     @relation("Reply")
  reactions   MessageReaction[]
  createdAt   DateTime          @default(now())

  @@index([sessionId, createdAt])
  @@index([replyToId])
  @@map("chatMessage")
}

// A task the agent runs on a schedule for a user, like "every morning at 8,
// summarize the news". Each run is saved as a chat.
model Routine {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The bot that runs it. Empty: the default assistant.
  botId      String?
  bot        Bot?      @relation(fields: [botId], references: [id], onDelete: Cascade)
  name       String
  // What the agent is asked each time.
  prompt     String
  // When it runs: a cron pattern ("0 8 * * *") in the user's time zone.
  cron       String
  timezone   String
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  // "ok", "failed", "needs-approval" or "no-allowance".
  lastStatus String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([botId, createdAt])
  @@index([userId, createdAt])
  @@map("routine")
}

// Something a user connected so their bots can use its tools. A user can have
// many, including several of the same app (two Gmail accounts).
// - app "mcp": the user's own MCP server (url, token kept by us, encrypted).
// - any other app (gmail, slack...): a Cencori connection; Cencori keeps the
//   sign-in, we keep its id.
model Integration {
  id           String           @id
  userId       String
  // The user's label, like "Work Gmail".
  name         String
  app          String           @default("mcp")
  url          String?
  token        String?
  connectionId String?
  enabled      Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  bots         BotIntegration[]

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@map("integration")
}

// A user's space at Cencori (a "tenant"), made the first time they connect an app.
model AgentWorkspace {
  userId    String   @id
  tenantId  String
  createdAt DateTime @default(now())

  @@map("agentWorkspace")
}

// A bot a user made: a name and instructions. Integrations are optional.
model Bot {
  id                String           @id
  userId            String
  name              String
  // One line on what it is for. The default assistant reads it to decide
  // when to hand a chat to this bot.
  description       String?
  instructions      String
  enabled           Boolean          @default(true)
  // Set once the bot uses a Cencori app connection (Gmail, Slack...).
  cencoriAgentId    String?
  installationId    String?
  // The connections that installation was made with, to spot changes.
  linkedConnections String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  integrations      BotIntegration[]
  memories          BotMemory[]
  skills            BotSkill[]
  routines          Routine[]
  groups            GroupMember[]
  documents         BotDocument[]
  plans             Plan[]
  listing           Listing?
  suggestions       BotSuggestion[]

  @@index([userId, createdAt])
  @@map("bot")
}

// A team of a user's bots that work on one chat together. A lead (built in)
// reads each message, asks the right bots, and they can ask each other.
model BotGroup {
  id           String        @id
  userId       String
  name         String
  description  String?
  // Optional: how the team should work together.
  instructions String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  members      GroupMember[]

  @@index([userId, createdAt])
  @@map("botGroup")
}

model GroupMember {
  groupId String
  group   BotGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  botId   String
  bot     Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([groupId, botId])
  @@index([botId])
  @@map("groupMember")
}

// A fact a bot knows ("The user's company is Acme"). Added by the user or
// saved by the bot itself during a chat.
model BotMemory {
  id        String   @id
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([botId, createdAt])
  @@map("botMemory")
}

// A playbook a bot can run: steps for one kind of job. The bot sees the name
// and description, and reads the full steps when it uses the skill.
model BotSkill {
  id             String   @id
  botId          String
  bot            Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  name           String
  description    String
  instructions   String
  // The copy at Cencori (safety scan and version history), when synced.
  cencoriSkillId String?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([botId, name])
  @@index([botId, createdAt])
  @@map("botSkill")
}

// A file in a user's knowledge (PDF, Word, text...). The original is kept in
// storage; its text is split into chunks that bots search during a chat.
model Document {
  id          String          @id
  userId      String
  name        String
  contentType String
  size        Int
  // Where the original file is kept (R2).
  key         String
  // "processing", "ready" or "failed" (then error says why).
  status      String          @default("processing")
  error       String?
  chunkCount  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  chunks      DocumentChunk[]
  bots        BotDocument[]

  @@index([userId, createdAt])
  @@map("document")
}

// One piece of a document's text, searchable with Postgres text search.
model DocumentChunk {
  id         String                   @id
  documentId String
  document   Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Copied from the document, so one user's chunks are found fast.
  userId     String
  position   Int
  text       String
  // Filled in by Postgres from text (a generated column).
  search     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, text)"))

  @@index([documentId, position])
  @@index([userId])
  @@index([search], type: Gin)
  @@map("documentChunk")
}

// Which documents a bot may search.
model BotDocument {
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([botId, documentId])
  @@index([documentId])
  @@map("botDocument")
}

// A big goal the planner splits into steps, then works through in the
// background, one step at a time. The work is saved as a chat.
model Plan {
  id        String     @id
  userId    String
  // The bot that does the steps. Empty: the default assistant.
  botId     String?
  bot       Bot?       @relation(fields: [botId], references: [id], onDelete: Cascade)
  goal      String
  // "planning", "running", "done", "failed", "stopped" or "needs-approval".
  status    String     @default("planning")
  // The chat the steps run in, once the first step starts.
  chatId    String?
  // The final answer, when done. Or why it failed.
  summary   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  steps     PlanStep[]

  @@index([userId, createdAt])
  @@map("plan")
}

model PlanStep {
  id           String    @id
  planId       String
  plan         Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  position     Int
  title        String
  // What the agent is asked to do in this step.
  instructions String
  // "waiting", "running", "done", "failed" or "needs-approval".
  status       String    @default("waiting")
  result       String?
  startedAt    DateTime?
  finishedAt   DateTime?

  @@unique([planId, position])
  @@map("planStep")
}

// A bot shared on the marketplace. It is a copy made when published, so later
// changes reach the marketplace only when published again. Memories,
// integrations and sign-ins are never shared.
model Listing {
  id           String    @id
  botId        String    @unique
  bot          Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId       String
  // Shown publicly as the author.
  authorName   String
  name         String
  description  String
  instructions String
  // The bot's skills: [{ name, description, instructions }].
  skills       Json
  category     String
  // "reviewing", "published" or "rejected" (then reviewNote says why).
  status       String    @default("reviewing")
  reviewNote   String?
  importCount  Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, importCount])
  @@index([status, publishedAt])
  @@index([userId])
  @@map("listing")
}

// Which integrations a bot may use.
model BotIntegration {
  botId         String
  bot           Bot         @relation(fields: [botId], references: [id], onDelete: Cascade)
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([botId, integrationId])
  @@index([integrationId])
  @@map("botIntegration")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

model AgentHost {
  id                       String            @id
  name                     String?
  userId                   String?
  user                     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCapabilities      String?
  publicKey                String?
  kid                      String?
  jwksUrl                  String?
  enrollmentTokenHash      String?
  enrollmentTokenExpiresAt DateTime?
  status                   String            @default("active")
  activatedAt              DateTime?
  expiresAt                DateTime?
  lastUsedAt               DateTime?
  createdAt                DateTime
  updatedAt                DateTime
  agents                   Agent[]
  approvalrequests         ApprovalRequest[]

  @@index([userId])
  @@index([kid])
  @@index([enrollmentTokenHash])
  @@index([status])
  @@map("agentHost")
}

model Agent {
  id                    String                 @id
  name                  String
  userId                String?
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostId                String
  agenthost             AgentHost              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  status                String                 @default("active")
  mode                  String                 @default("delegated")
  publicKey             String
  kid                   String?
  jwksUrl               String?
  lastUsedAt            DateTime?
  activatedAt           DateTime?
  expiresAt             DateTime?
  metadata              String?
  createdAt             DateTime
  updatedAt             DateTime
  agentcapabilitygrants AgentCapabilityGrant[]
  approvalrequests      ApprovalRequest[]

  @@index([userId])
  @@index([hostId])
  @@index([status])
  @@index([kid])
  @@map("agent")
}

model AgentCapabilityGrant {
  id            String    @id
  agentId       String
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  capability    String
  // Fixed by hand: the generator merges these two user links into one field.
  // Re-apply after `bun run auth:generate` if it reverts them.
  deniedBy      String?
  deniedByUser  User?     @relation("AgentGrantDeniedBy", fields: [deniedBy], references: [id], onDelete: Cascade)
  grantedBy     String?
  grantedByUser User?     @relation("AgentGrantGrantedBy", fields: [grantedBy], references: [id], onDelete: Cascade)
  expiresAt     DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  status        String    @default("active")
  reason        String?
  constraints   String?

  @@index([agentId])
  @@index([capability])
  @@index([grantedBy])
  @@index([deniedBy])
  @@index([status])
  @@map("agentCapabilityGrant")
}

model ApprovalRequest {
  id                         String     @id
  method                     String
  agentId                    String?
  agent                      Agent?     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  hostId                     String?
  agenthost                  AgentHost? @relation(fields: [hostId], references: [id], onDelete: Cascade)
  userId                     String?
  user                       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilities               String?
  status                     String     @default("pending")
  userCodeHash               String?
  loginHint                  String?
  bindingMessage             String?
  clientNotificationToken    String?
  clientNotificationEndpoint String?
  deliveryMode               String?
  interval                   Int
  lastPolledAt               DateTime?
  expiresAt                  DateTime
  createdAt                  DateTime
  updatedAt                  DateTime

  @@index([agentId])
  @@index([hostId])
  @@index([userId])
  @@index([status])
  @@map("approvalRequest")
}

// What a user's AI work used, one row per day and kind of work. Filled in
// from what Cencori reports after every model call.
model UsageDay {
  userId       String
  day          DateTime @db.Date
  // "chat", "routine", "plan", "group", "voice" or "review".
  kind         String
  // Model calls (one answer can take several).
  calls        Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)

  @@id([userId, day, kind])
  @@index([day])
  @@map("usageDay")
}

// A user's plan, which sets their monthly AI allowance. No row: free.
model BillingPlan {
  userId          String   @id
  // "free", "pro" or "business" (see config/billing/plans.ts).
  plan            String   @default("free")
  // Set by staff to give one user a different allowance (USD a month).
  monthlyLimitUsd Float?
  updatedAt       DateTime @updatedAt

  @@map("billingPlan")
}

// The user's standing answer for a risky tool, so they are not asked every
// time. The most specific rule wins: this chat, then this bot, then everywhere.
model ToolRule {
  id        String    @id
  userId    String
  // The tool's name, like "create_routine" or an app tool's name.
  tool      String
  // Only in this bot's chats. Empty: everywhere.
  botId     String?
  // Only in this chat. Empty: every chat.
  chatId    String?
  // "allow", "ask" or "deny".
  decision  String
  // Empty: until the user removes it.
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, tool])
  @@map("toolRule")
}

// A step waiting for the user's OK: the approvals inbox. Made when a chat,
// routine or plan stops at a risky tool; gone once the user decides.
model PendingApproval {
  id        String   @id
  userId    String
  chatId    String
  botId     String?
  // "chat", "routine" or "plan".
  source    String
  // [{ callId, toolName, arguments, agentName }]
  items     Json
  // The signed paused run, sent back with the decisions to carry on.
  state     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([chatId])
  @@map("pendingApproval")
}

// What happened in an account: sign-ins, changes, tools the AI ran, and
// staff actions. Users see their own; staff see all.
model ActivityLog {
  id        String   @id
  // Whose account it is about. Empty: platform-wide.
  userId    String?
  // Who did it: the user, an AI agent ("agent:<name>") or staff.
  actor     String
  // Like "bot.created", "tool.ran" or "approval.allowed".
  action    String
  // What it was done to, like a bot id or tool name.
  target    String?
  // A short plain note.
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("activityLog")
}

// An emoji reaction to a message, like in WhatsApp. One per person per
// message; a new one replaces the old.
model MessageReaction {
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime    @default(now())

  @@id([messageId, userId])
  @@map("messageReaction")
}

// A change a bot suggests to itself after learning from its chats. Nothing
// changes until the user accepts it.
model BotSuggestion {
  id           String   @id
  botId        String
  bot          Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId       String
  // "instructions" (new instructions) or "skill" (a new skill).
  kind         String
  title        String
  // Why, from what happened in the chats.
  reason       String
  // For "instructions": the full new instructions.
  instructions String?
  // For "skill": { name, description, instructions }.
  skill        Json?
  // "pending", "accepted" or "dismissed".
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  @@index([botId, status, createdAt])
  @@map("botSuggestion")
}

// A user's own computer in the cloud (an InstaBox machine), where their
// agents run commands and keep files. Made the first time an agent needs it.
model AgentComputer {
  userId     String   @id
  machineId  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@map("agentComputer")
}
